      "id": "G2",
      "phases": ["P121-P135"],
      "evidence": "Apple UART TX, RX, FIFO and IRQ regressions pass; reviewed trace establishes host RX to UART to AIC delivery and acknowledgment."
    },
    {
      "id": "G3",
      "phases": ["P136-P180"],
      "evidence": "AIC device IRQ, separate architectural timer FIQ and two-core IPI acknowledgment pass independently; a one-core Linux witness does not waive this prerequisite."
    },
    {
      "id": "boot-handoff",
      "phases": ["P181-P195"],
      "evidence": "Entry-state probe, reviewed FDT, nonoverlapping image/initramfs/RAM reservations and explicit clock, power and firmware-state assumptions pass together."
    },
    {
      "id": "linux-integration",
      "phases": ["P196-P209"],
      "evidence": "Pinned source/configuration/patches, deterministic initramfs, active Apple drivers, scheduler, serial shell and bounded fresh-process capture are reproducible."
    }
  ],
  "witness": {
    "profile": "linux-v6.12-observables-v1",
    "guest_script": "experiments/linux-boot-witness/probe.sh",
