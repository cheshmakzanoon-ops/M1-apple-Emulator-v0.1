  "observations": [
    {"id": "fresh-process", "requirement": "Three independent cold QEMU processes use identical hashed inputs and unique challenges; no snapshot, migration restore or recycled console log."},
    {"id": "interactive-shell", "requirement": "After READY the host sends a fresh nonce and two operands through Apple UART; the probe returns their sum, exits, and a second command through the returned shell produces their product after END."},
    {"id": "active-drivers", "requirement": "Guest reports aarch64, exact J274/T8103 compatible sequence, ttySAC0 as active console, samsung-uart binding and one online CPU."},
    {"id": "uart-irq", "requirement": "Raw before/after interrupt snapshots retain the same AIC UART row and show increased activity across the input exchange; G2/G3 trace supplies RX causality."},
    {"id": "timer-fiq", "requirement": "The separate AIC-FIQ arch_timer row advances and guest uptime advances at least one second across sleep; G3 independently proves the hardware FIQ route."},
    {"id": "bounded-run", "requirement": "A monotonic host deadline covers startup and each exchange; timeout, premature process exit, panic, malformed or missing response and hash mismatch fail."},
    {"id": "reviewed-evidence", "requirement": "Full serial, host-input events, emulator stderr, command, manifests, input hashes and prerequisite traces are retained and independently reviewed at P210."}
